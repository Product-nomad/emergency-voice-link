# Public-by-design Supabase client credentials.
# These values are embedded in the client bundle at build time, so they
# must be safe to expose. Use the Supabase ANON / publishable key here,
# never the service-role key. Server-side secrets (ELEVENLABS_API_KEY,
# SUPABASE_SERVICE_ROLE_KEY, ELEVENLABS_AGENT_ID) live in the Supabase
# Edge Function environment, NOT in this file.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# This build's own production domain. Set per-Vercel-project (each of the
# three production domains is its own project — see README). Used by
# scripts/generate-sitemap.mjs to write an absolute-URL sitemap.xml scoped
# to the domain this build is actually deployed to. Not needed for local dev.
VITE_SITE_URL=https://your-domain.example

# Public-by-design Supabase client credentials (feedback storage only —
# the ElevenLabs token function moved off Supabase 2026-07-30).
# These values are embedded in the client bundle at build time, so they
# must be safe to expose. Use the Supabase ANON / publishable key here,
# never the service-role key.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Server-side secrets for api/elevenlabs-conversation-token.ts (a Vercel Edge
# Function). Set these as plain — NOT VITE_-prefixed — environment variables
# on each Vercel project. Never add the VITE_ prefix to these: that would bake
# them into the public client bundle (see README's env-var table for how this
# is verified). Not read from this file at all in production — only useful
# locally if you're running `vercel dev` to test a real call.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id

# This build's own production domain. Set per-Vercel-project (each of the
# three production domains is its own project — see README). Used by
# scripts/generate-sitemap.mjs to write an absolute-URL sitemap.xml scoped
# to the domain this build is actually deployed to. Not needed for local dev.
VITE_SITE_URL=https://your-domain.example
